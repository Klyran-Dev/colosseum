FROM node:26.11.1-bookworm-slim@sha256:86f07bc9c5dce4578cf37e5a418b7bfc7f817cda25cde66e2b66e95ed86c4567 AS builder

WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@12.3.4 --activate
COPY apps/web/package.json apps/web/pnpm-lock.yaml apps/web/pnpm-workspace.yaml ./apps/web/
RUN pnpm --dir apps/web install --frozen-lockfile
COPY contracts ./contracts
COPY test-vectors ./test-vectors
COPY apps/web ./apps/web
COPY ops/nginx/nginx.conf ./ops/nginx/nginx.conf
COPY scripts/render_web_nginx_config.mjs ./scripts/render_web_nginx_config.mjs
ARG VITE_DEPLOYMENT_ENVIRONMENT
ARG VITE_SOLANA_NETWORK
ARG VITE_AUTH_METHOD
ARG VITE_LOCAL_UI_MODE
ARG VITE_AUTH_SERVICE_BASE_URL
ARG VITE_OIDC_ISSUER
ARG VITE_OIDC_CLIENT_ID
ARG VITE_OIDC_REDIRECT_URI
ARG VITE_OIDC_SCOPE
ARG VITE_OIDC_AUDIENCE
ARG VITE_INDEXER_STREAM_KEY
ENV VITE_DEPLOYMENT_ENVIRONMENT=${VITE_DEPLOYMENT_ENVIRONMENT}
ENV VITE_SOLANA_NETWORK=${VITE_SOLANA_NETWORK}
ENV VITE_AUTH_METHOD=${VITE_AUTH_METHOD}
ENV VITE_LOCAL_UI_MODE=${VITE_LOCAL_UI_MODE}
ENV VITE_AUTH_SERVICE_BASE_URL=${VITE_AUTH_SERVICE_BASE_URL}
ENV VITE_OIDC_ISSUER=${VITE_OIDC_ISSUER}
ENV VITE_OIDC_CLIENT_ID=${VITE_OIDC_CLIENT_ID}
ENV VITE_OIDC_REDIRECT_URI=${VITE_OIDC_REDIRECT_URI}
ENV VITE_OIDC_SCOPE=${VITE_OIDC_SCOPE}
ENV VITE_OIDC_AUDIENCE=${VITE_OIDC_AUDIENCE}
ENV VITE_INDEXER_STREAM_KEY=${VITE_INDEXER_STREAM_KEY}
RUN pnpm --dir apps/web build
RUN node scripts/render_web_nginx_config.mjs ops/nginx/nginx.conf /workspace/generated-nginx.conf

FROM nginx:1.30.5-alpine@sha256:bf3201ab56f23e5954646379c775d511fc466e9f11376d9725361064ad07ed35 AS runtime
COPY ops/nginx/nginx-main.conf /etc/nginx/nginx.conf
COPY --from=builder /workspace/generated-nginx.conf /etc/nginx/conf.d/default.conf
# The upstream name is supplied by Compose DNS at runtime and is not
# resolvable during an image build. Validate the complete configuration with
# a loopback-only test upstream while preserving the production files.
RUN mkdir -p /tmp/nginx /tmp/nginx-test-conf.d \
  && sed 's#http://api:8080/#http://127.0.0.1:8080/#' \
       /etc/nginx/conf.d/default.conf > /tmp/nginx-test-conf.d/default.conf \
  && sed 's#/etc/nginx/conf.d/\*\.conf#/tmp/nginx-test-conf.d/*.conf#' \
       /etc/nginx/nginx.conf > /tmp/nginx-test.conf \
  && nginx -t -c /tmp/nginx-test.conf
COPY --from=builder /workspace/apps/web/dist /usr/share/nginx/html

# Run the complete static edge as an unprivileged user. The configured
# temporary paths and logs are writable without granting the container a
# writable system directory or Linux capabilities.
RUN mkdir -p \
      /tmp/nginx/client_temp \
      /tmp/nginx/proxy_temp \
      /tmp/nginx/fastcgi_temp \
      /tmp/nginx/uwsgi_temp \
      /tmp/nginx/scgi_temp \
      /var/cache/nginx \
      /var/log/nginx \
  && chown -R nginx:nginx \
      /tmp/nginx \
      /var/cache/nginx \
      /var/log/nginx

USER nginx
EXPOSE 8080
