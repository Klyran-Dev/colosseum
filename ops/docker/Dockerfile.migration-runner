FROM rust:1.99.0-bookworm@sha256:114c7a4425406451c2866b6aafe69fe29b1b298832db1277d411ac73c82d04d6 AS builder

WORKDIR /workspace
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY programs ./programs
RUN cargo build --locked --release -p migration-runner

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

RUN groupadd --system --gid 10001 migrator \
    && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent \
       --shell /usr/sbin/nologin migrator
COPY --from=builder /workspace/target/release/migration-runner /usr/local/bin/migration-runner
USER migrator:migrator
ENTRYPOINT ["/usr/local/bin/migration-runner"]
