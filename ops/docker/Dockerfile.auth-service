FROM rust:1.99.1-bookworm@sha256:e12566d5abc17a0da741628782cdb504b68b8961f5bfcf677936bf3e8b32de29 AS builder

WORKDIR /workspace
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY contracts ./contracts
COPY crates ./crates
COPY programs ./programs

RUN cargo build --locked --release -p auth-service

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251

RUN groupadd --system --gid 10001 app \
  && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin app \
  && apt-get update \
  && apt-get install --yes --no-install-recommends ca-certificates wget \
  && rm -rf /var/lib/apt/lists/* \
  && install --directory --owner=app --group=app /var/lib/auth/inbox

COPY --from=builder /workspace/target/release/auth-service /usr/local/bin/auth-service

USER app:app
EXPOSE 8085
ENTRYPOINT ["/usr/local/bin/auth-service"]
