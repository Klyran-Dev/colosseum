# External synthetic issuer used only by Docker integration tests. It is
# deliberately a separate image from the API and contains no API secrets.
FROM rust:1.98.1-bookworm@sha256:93ce27a88655056a51dbdd8f5f2d7ddc071c7b0070fb288a37b5a285fc83971e AS builder
WORKDIR /workspace
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY programs ./programs
RUN cargo build --locked --release -p attestation-fixture

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
RUN groupadd --system --gid 10001 issuer \
    && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent \
       --shell /usr/sbin/nologin issuer
COPY --from=builder /workspace/target/release/attestation-fixture /usr/local/bin/attestation-fixture
USER issuer:issuer
ENTRYPOINT ["/usr/local/bin/attestation-fixture"]
