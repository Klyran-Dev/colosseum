FROM mcr.microsoft.com/playwright:v1.64.0-noble@sha256:06a9939e57531807f8d5fd76ce44b53165ffb7d7501d87ab10e285c20b1e971f

WORKDIR /workspace
ENV CI=true
ENV COREPACK_HOME=/opt/corepack

RUN mkdir -p /opt/corepack \
  && corepack enable \
  && corepack prepare pnpm@12.3.4 --activate
COPY --chown=pwuser:pwuser apps/web/package.json apps/web/pnpm-lock.yaml apps/web/pnpm-workspace.yaml ./apps/web/
RUN pnpm --dir apps/web install --frozen-lockfile

COPY --chown=pwuser:pwuser contracts ./contracts
COPY --chown=pwuser:pwuser test-vectors ./test-vectors
COPY --chown=pwuser:pwuser apps/web ./apps/web
USER pwuser

CMD ["/bin/sh", "-c", "/workspace/apps/web/node_modules/.bin/tsc --noEmit -p /workspace/apps/web/tsconfig.e2e.json && node /workspace/apps/web/node_modules/@playwright/test/cli.js test --config /workspace/apps/web/playwright.config.ts"]
