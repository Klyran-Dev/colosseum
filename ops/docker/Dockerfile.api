FROM rust:1.100.0-bookworm@sha256:ade39a710ef85f3506cffcfec3e8a24ba090badef1dff2fb798f71d878833fea AS builder

WORKDIR /workspace
COPY rust-toolchain.toml Cargo.toml Cargo.lock ./
COPY contracts ./contracts
COPY crates ./crates
COPY programs ./programs

RUN cargo build --locked --release -p api

FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251 AS runtime

RUN groupadd --system --gid 10001 app \
  && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent --shell /usr/sbin/nologin app \
  && apt-get update \
  && apt-get install --yes --no-install-recommends ca-certificates wget \
  && rm -rf /var/lib/apt/lists/*

COPY --from=builder /workspace/target/release/api /usr/local/bin/api
COPY scripts/verify_deployment_config.sh /usr/local/bin/verify_deployment_config

USER app
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/api"]
