FROM --platform=linux/amd64 ghcr.io/foundry-rs/foundry:v1.8.1@sha256:3a16888f6fe5abee49b0a3e8210255c5d89445b5c08fbcef443dd4e3703146aa

WORKDIR /workspace
COPY --chown=foundry:foundry evm-adapter ./evm-adapter

USER root
ADD --checksum=sha256:5de843c2c93563cc66425c99a4fb13fdbf32b4c4ae07469480faaf126e14404a https://binaries.soliditylang.org/linux-amd64/solc-linux-amd64-v0.8.37+commit.f401782d /usr/local/bin/solc
RUN chmod 0755 /usr/local/bin/solc \
    && solc --version

USER foundry
RUN forge test --root evm-adapter --use /usr/local/bin/solc --offline
