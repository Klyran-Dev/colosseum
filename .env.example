# Copy to an untracked .env only for a local Google Workspace SMTP test.
# Never commit the copied file or paste the app password into source/chat.
AUTH_ENV=local
POSTGRES_DB=tax_protocol
POSTGRES_USER=tax_protocol
POSTGRES_PASSWORD=local-development-only
APP_DATABASE_URL=postgres://tax_protocol:local-development-only@postgres:5432/tax_protocol
HOST_BIND_ADDRESS=127.0.0.1
VITE_DEPLOYMENT_ENVIRONMENT=local
VITE_SOLANA_NETWORK=localnet
VITE_SOLANA_RPC_URL=http://localhost:8899
AUTH_EMAIL_MODE=google-smtp
AUTH_OTP_RATE_LIMIT_WINDOW_SECONDS=900
# Set true only when this environment should accept open account creation.
AUTH_SELF_SIGNUP=false
AUTH_SELF_SIGNUP_DAILY_LIMIT=25
AUTH_EMAIL_FROM="Solana Tax Protocol <noreply@klyran.com>"
AUTH_EMAIL_SMTP_HOST=smtp.gmail.com
AUTH_EMAIL_SMTP_PORT=587
AUTH_EMAIL_SMTP_SECURITY=starttls
AUTH_EMAIL_SMTP_AUTH=app-password
AUTH_EMAIL_SMTP_TIMEOUT_MILLIS=10000
AUTH_EMAIL_SMTP_USERNAME=noreply@klyran.com
AUTH_EMAIL_SMTP_PASSWORD=replace-with-a-runtime-app-password
